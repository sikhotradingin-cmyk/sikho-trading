{
  "name": "tradingzone-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Tradingzone - Android-first Indian Securities Paper-Trading Platform Monorepo",
  "workspaces": [
    "packages/shared",
    "packages/backend",
    "packages/mobile"
  ],
  "scripts": {
    "build:shared": "npm --workspace=packages/shared run build",
    "build:backend": "npm --workspace=packages/backend run build",
    "test:shared": "npm --workspace=packages/shared test",
    "test:backend": "npm --workspace=packages/backend test",
    "test:mobile": "npm --workspace=packages/mobile test",
    "test": "npm --workspace=packages/shared test && npm --workspace=packages/backend test && npm --workspace=packages/mobile test",
    "start:backend": "npm --workspace=packages/backend run dev",
    "start:mobile": "npm --workspace=packages/mobile run start"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
