{
  "name": "@trading/backend",
  "version": "1.0.0",
  "private": true,
  "main": "./dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:test": "tsc -p tsconfig.test.json",
    "start": "node dist/server.js",
    "dev": "tsc -p tsconfig.test.json && node dist/server.js",
    "migrate": "node dist/db/migrate.js",
    "test": "npm run build:test && node --test dist/**/*.test.js",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "benchmark": "tsc -p tsconfig.test.json && node dist/benchmarks/load-test.js"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@fastify/jwt": "^10.2.7",
    "@fastify/websocket": "^11.3.7",
    "@trading/shared": "*",
    "@types/node": "^22.8.7",
    "@types/pg": "^8.11.10",
    "@types/ws": "^8.5.12",
    "dotenv": "^16.4.5",
    "fastify": "^5.12.8",
    "google-auth-library": "^11.3.3",
    "pg": "^8.13.1",
    "ws": "^8.18.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "pg-mem": "^3.0.14",
    "typescript": "^5.6.3"
  }
}
