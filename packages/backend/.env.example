PORT=4000
HOST=0.0.0.0
NODE_ENV=development
JWT_SECRET=development-insecure-secret-key-change-in-prod

# ==============================================================================
# Angel One SmartAPI Credentials (Private Local Development Only)
# Leave blank to fall back safely to Deterministic Demo Mode.
# ==============================================================================
# API Key from SmartAPI Developer Portal (https://smartapi.angelone.in)
SMARTAPI_API_KEY=

# Angel One Trading Client Code / User ID (e.g. AB12345)
SMARTAPI_CLIENT_CODE=

# Numeric 4-digit MPIN (Angel One uses 4-digit MPIN as the password field)
SMARTAPI_PASSWORD=

# RFC-6238 TOTP Base32 Secret Key (from Authenticator App setup key)
SMARTAPI_TOTP_SECRET=

# Registered Outbound Static Public IPv4 Address (Default: 45.115.52.180)
SMARTAPI_CLIENT_PUBLIC_IP=45.115.52.180
