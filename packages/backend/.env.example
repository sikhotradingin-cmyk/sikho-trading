PORT=4000
HOST=0.0.0.0
NODE_ENV=production
JWT_SECRET=change-this-to-a-cryptographically-secure-random-string-in-production

# ==============================================================================
# Managed PostgreSQL Connection String
# e.g., postgres://user:password@hostname:5432/dbname?sslmode=require
# If left empty, backend runs in-memory emulated database (resets on restart).
# ==============================================================================
DATABASE_URL=
DATABASE_SSL=true

# ==============================================================================
# Production Network & Security
# Set CORS_ORIGIN to comma-separated allowed origins or leave unset for standard clients
# ==============================================================================
CORS_ORIGIN=
ENFORCE_LOCAL_DEV_IP=false

# ==============================================================================
# Primary Market-Data Provider Selection
# Supported values: UPSTOX | SMARTAPI | DEMO
# ==============================================================================
MARKET_DATA_PROVIDER=UPSTOX

# ==============================================================================
# Upstox Market Data / Analytics Token (Primary Provider)
# Generate an Analytics Token (1-year validity, read-only) or API Access Token
# from https://account.upstox.com/developer/apps
# ==============================================================================
UPSTOX_ANALYTICS_TOKEN=

# ==============================================================================
# Google OAuth 2.0 Client ID (for Google Sign-In verification)
# ==============================================================================
GOOGLE_CLIENT_ID=

# ==============================================================================
# Angel One SmartAPI Credentials (Preserved Selectable Alternative)
# Set MARKET_DATA_PROVIDER=SMARTAPI to use Angel One SmartAPI.
# ==============================================================================
SMARTAPI_API_KEY=
SMARTAPI_CLIENT_CODE=
SMARTAPI_PASSWORD=
SMARTAPI_TOTP_SECRET=
SMARTAPI_CLIENT_PUBLIC_IP=45.115.52.180
